# One codebase, two deployments — pick which with AGENT_MODE. Unset (or any
# value other than "host") defaults to "room", so an already-deployed
# container's .env keeps working untouched after the room-agent -> mini-agent
# rename.
AGENT_MODE=room

# --- room mode ---
# The ROOM's own secret — must match ROOM_COMPANION_TOKEN on the Mission Control
# host, and must NOT equal that host's COMPANION_TOKEN.
ROOM_TOKEN=
ROOM_ROOT=/home/akira/workshop
ROOM_DOORWAY=/mnt/doorway
# Mission Control, reached over the LXD host bridge (not the public tunnel).
MINI_URL=http://10.0.0.1:3000

# --- host mode (AGENT_MODE=host) ---
# The HOST's own secret — must match HOST_COMPANION_TOKEN on the Mission
# Control side, and must NOT equal COMPANION_TOKEN or ROOM_COMPANION_TOKEN.
# HOST_TOKEN=
# HOST_DEFAULT_CWD=/
# The host agent runs on the same box as Mission Control, so it uses loopback
# instead of the LXD bridge address.
# MINI_URL=http://127.0.0.1:3000
