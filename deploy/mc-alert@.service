[Unit]
Description=Alert that %i failed
# Templated failure handler. Wire it into any unit worth knowing about with:
#   OnFailure=mc-alert@%n.service
# systemd passes the FAILED unit's name as the instance (%i), so one template
# covers every job.

[Service]
Type=oneshot
User=mc
Group=mc
# Without this, `journalctl -u <failed-unit>` returns NOTHING as mc and the alert
# fires with no context — the unit name and "failed", but not a word about why.
# Verified on the Mini 2026-08-14: mc is in neither adm nor systemd-journal.
SupplementaryGroups=systemd-journal
EnvironmentFile=/srv/mission-control/.env
ExecStart=/srv/mission-control/deploy/mc-alert.sh %i
